# Application
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://flowai_user:flowai_password@localhost:5432/flowai_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="super-secret-jwt-key-flowai-workspace-production-ready"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="super-secret-refresh-key-flowai-workspace"
JWT_REFRESH_EXPIRES_IN="30d"

# OAuth (Google)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# AI Service (OpenAI / Anthropic / Local Ollama)
AI_PROVIDER="openai"
AI_API_KEY="sk-proj-your-ai-api-key"
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_CHAT_MODEL="gpt-4o-mini"

# S3 Compatible Storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minio-access-key"
S3_SECRET_KEY="minio-secret-key"
S3_BUCKET="flowai-attachments"
S3_REGION="us-east-1"

# Frontend Public Env
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
